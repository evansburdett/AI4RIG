{
  "name": "@ai4rig/desktop",
  "productName": "AI4RIG",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Electron shell: runs the API and the built front end as one desktop app (ADR 0003, ADR 0007).",
  "author": "Auburn Senior Design Team 22",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron stage",
    "dist": "node scripts/build.mjs && electron-builder --config electron-builder.yml",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@ai4rig/api": "*",
    "@ai4rig/db": "*",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2"
  }
}
