# Copy this file to .env and adjust if you need to. `npm run setup` does the
# copy for you. .env is gitignored — it is per-machine, never shared.
#
# `npm run doctor` fails if .env is missing any key listed here, so when you
# add a key, add it here in the same commit.

# development | test | production
NODE_ENV=development

# Address the API binds to.
#   127.0.0.1 — normal development. Loopback only; nothing else on the network
#               can reach your API.
#   0.0.0.0   — host mode at RIG, where advisor workstations on the office LAN
#               connect to one designated host machine.
API_HOST=127.0.0.1
API_PORT=3001

# Browser origin the API accepts cross-origin requests from (the Vite dev
# server). Comma-separate for more than one.
WEB_ORIGIN=http://localhost:5173

# SQLite database file, relative to the repo root. This file is yours alone:
# it is gitignored, disposable, and rebuilt with `npm run db:reset`.
DATABASE_PATH=./data/ai4rig.db

# Where the front end sends API requests. Read in exactly one place —
# apps/web/src/api.ts. Anything VITE_-prefixed is compiled into the browser
# bundle, so never put a secret here.
VITE_API_BASE_URL=http://127.0.0.1:3001
