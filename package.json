{
  "name": "ai4rig",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Advisor-facing bucket planning tool for Railroad Investment Group (Auburn Senior Design, Team 22)",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/desktop",
    "packages/engine",
    "packages/db"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "db:migrate": "npm run migrate --workspace packages/db",
    "db:seed": "npm run seed --workspace packages/db",
    "db:reset": "npm run reset --workspace packages/db",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
