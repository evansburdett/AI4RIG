# Normalize line endings. Everything in the working tree is checked out with
# LF on macOS and Windows alike, so a Windows checkout never shows an
# unrelated whole-file diff. See docs/DEVELOPMENT.md "Line-ending problems".
* text=auto eol=lf

*.md        text eol=lf
*.json      text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.mjs       text eol=lf
*.js        text eol=lf
*.sql       text eol=lf
*.yml       text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.puml      text eol=lf
*.sh        text eol=lf
.nvmrc      text eol=lf

# Windows-only files that genuinely need CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binary — never touch
*.png       binary
*.jpg       binary
*.ico       binary
*.jar       binary
*.db        binary
*.sqlite    binary
