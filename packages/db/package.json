{
  "name": "@ai4rig/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SQLite connection, migration runner, and seed loader",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "migrate": "tsx src/cli/migrate.ts",
    "seed": "tsx src/cli/seed.ts",
    "reset": "tsx src/cli/reset.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "tsx": "^4.23.13"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2"
  }
}
